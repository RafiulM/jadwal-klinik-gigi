{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klinik-gigi",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./cloudflare/worker.ts",
  // Run the Worker next to Supabase (ap-southeast-1), same as Vercel sin1.
  "placement": { "region": "aws:ap-southeast-1" },
  "observability": { "enabled": true },
  // *.workers.dev is blocked by some Indonesian ISP DNS (XL Axiata), so the
  // app is served from a custom domain on a zone already in this account.
  "routes": [{ "pattern": "klinik-cf.ngodingpakeai.com", "custom_domain": true }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6e02c69a09a34bb798b3fd444e59f0c8"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://klinik-cf.ngodingpakeai.com"
  }
}
